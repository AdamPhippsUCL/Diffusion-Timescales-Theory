%% Ball phase variance change with delta and Delta

mean_seq_pv_ball = mean(seq_phase_vars_ball);
f=figure;
f.Position = [680   368   659   510];

for seqindx = 1:Nseq


    if strcmp(seq_names{seqindx},'b1000_Delta40') 
        plot( ...
            [seq_Deltas(seqindx) seq_Deltas(seqindx)], ...
            [0 (seq_phase_vars_ball(seqindx)-mean_seq_pv_ball)/norm_value], ...
            '-', ...
            color = [.2 .2 .2], ...
            HandleVisibility='off'...
            )
        hold on
        scatter( ...
            seq_Deltas(seqindx), ...
            (seq_phase_vars_ball(seqindx)-mean_seq_pv_ball)/norm_value,...
            100,...
            '*',...
            LineWidth =1.1,...
            DisplayName=seq_names{seqindx},...
            MarkerEdgeColor=cols(4,:),...
            MarkerFaceColor=cols(4,:)...
            )
        continue               
    end


    plot( ...
        [seq_Deltas(seqindx) seq_Deltas(seqindx)], ...
        [0 (seq_phase_vars_ball(seqindx)-mean_seq_pv_ball)/norm_value], ...
        '-', ...
        color = [.2 .2 .2], ...
        HandleVisibility='off'...
        )

    hold on

    scatter( ...
        seq_Deltas(seqindx), ...
        (seq_phase_vars_ball(seqindx)-mean_seq_pv_ball)/norm_value,...
        100,...
        '*',...
        LineWidth =1.1,...
        DisplayName=seq_names{seqindx},...
        MarkerEdgeColor=cols(seqindx,:),...
        MarkerFaceColor=cols(seqindx,:)...
        )
end

yline(0, '--', HandleVisibility='on', DisplayName='Mean value')



