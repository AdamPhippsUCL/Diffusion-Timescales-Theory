    %     % saveas(f4, 'phase_var_sequences_ex_vivo_stroma.png')

end


%% Sphere phase variance change with delta and Delta

norm_value = phase_var_sat*(5/2);

mean_seq_pv_sphere = mean(seq_phase_vars_sphere);
f=figure;
f.Position = [680   200   659   510];


for seqindx = 1:Nseq

    if strcmp(seq_names{seqindx},'b1000_Delta40') 
        scatter( ...
            seq_Deltas(seqindx), ...
            (seq_phase_vars_sphere(seqindx)-mean_seq_pv_sphere)/norm_value,...
            'filled',...
            DisplayName=seq_names{seqindx},...
            MarkerEdgeColor=cols(4,:),...
            MarkerFaceColor=cols(4,:)...
            )
        continue
    end

    plot( ...
        [seq_Deltas(seqindx) seq_Deltas(seqindx)], ...
        [0 (seq_phase_vars_sphere(seqindx)-mean_seq_pv_sphere)/norm_value], ...
        '-', ...
        color = [.2 .2 .2], ...
        HandleVisibility='off'...
        )

    hold on

    scatter( ...
        seq_Deltas(seqindx), ...
        (seq_phase_vars_sphere(seqindx)-mean_seq_pv_sphere)/norm_value,...
        'filled',...
        DisplayName=seq_names{seqindx},...
        MarkerEdgeColor=cols(seqindx,:),...
        MarkerFaceColor=cols(seqindx,:)...
        )
end

yline(0, '--', HandleVisibility='on', DisplayName='Mean value')



